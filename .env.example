# Supabase — create a project at https://supabase.com and paste values below
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: used only for seed scripts / server admin helpers
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL (no trailing slash). Required behind Docker/App Platform so
# OAuth redirects never use http://0.0.0.0:3000 from HOSTNAME binding.
# NEXT_PUBLIC_SITE_URL=https://amg-com-2j9zz.ondigitalocean.app

# When true (or when Supabase URL is missing), the app uses local demo data
NEXT_PUBLIC_DEMO_MODE=true

# Twilio SMS (server-only) — order confirmed / dispatched / delivered alerts
# Get these from https://console.twilio.com — never commit real values
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
# Sender: use a Twilio phone number OR a Messaging Service SID (prefer one)
TWILIO_PHONE_NUMBER=+254XXXXXXXXX
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email (server-only, via Resend) — same order events as SMS
# Get an API key from https://resend.com — never commit real values
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM="AMG Stores <orders@yourdomain.com>"

# Web Push (rider payout alerts) — generate a keypair with:
# node -e "console.log(require('web-push').generateVAPIDKeys())"
# The public key is safe to expose to the browser; the private key is not.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@yourdomain.com

# M-Pesa Daraja STK push (server-only) — real "pay now" checkout.
# Without these set, checkout uses a simulated instant confirmation instead
# (safe default for demo/dev — never blocks checkout).
# Get credentials from https://developer.safaricom.co.ke
# MPESA_ENV=sandbox
# MPESA_CONSUMER_KEY=your-consumer-key
# MPESA_CONSUMER_SECRET=your-consumer-secret
# MPESA_SHORTCODE=174379
# MPESA_PASSKEY=your-passkey
# MPESA_CALLBACK_URL=https://yourdomain.com/api/mpesa/callback
