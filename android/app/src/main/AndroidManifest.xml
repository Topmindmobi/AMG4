<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.Launcher">

        <meta-data
            android:name="asset_statements"
            android:resource="@string/asset_statements" />

        <!-- Loads https://amgstores.ai as a Trusted Web Activity: full-screen Chrome,
             no URL bar, once Digital Asset Links verification passes (see
             public/.well-known/assetlinks.json in the web repo). Any content change
             on the live site is what shoppers see here — no app-store update needed
             for anything except native shell changes (icon, splash, permissions). -->
        <activity
            android:name="com.google.androidbrowserhelper.trusted.LauncherActivity"
            android:exported="true"
            android:label="@string/app_name">

            <meta-data
                android:name="android.support.customtabs.trusted.DEFAULT_URL"
                android:value="https://amgstores.ai/" />

            <meta-data
                android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR"
                android:resource="@color/colorPrimary" />

            <meta-data
                android:name="android.support.customtabs.trusted.NAVIGATION_BAR_COLOR"
                android:resource="@color/colorBackground" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- https://amgstores.ai links from outside the app (search results, other
                 apps, SMS) open directly in this app instead of a browser tab, once
                 asset-link verification passes. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="amgstores.ai" />
            </intent-filter>
        </activity>

        <!-- Lets the site's existing web-push notifications (public/sw.js) be shown
             with the app's identity instead of a browser's. -->
        <service
            android:name="com.google.androidbrowserhelper.trusted.DelegationService"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.support.customtabs.trusted.TRUSTED_WEB_ACTIVITY_SERVICE" />
            </intent-filter>
        </service>
    </application>
</manifest>
